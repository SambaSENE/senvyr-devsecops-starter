{
  "uid": "senvyr-services",
  "title": "SENVYR - Etat des services",
  "tags": ["senvyr", "monitoring"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cibles de supervision disponibles",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "senvyr-prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up)", "instant": true }],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 2,
      "title": "Disponibilite par service (1 = disponible)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "senvyr-prometheus" },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}", "range": true }],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "none" } }
    }
  ]
}
